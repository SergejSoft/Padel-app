# Copy to .env. Option A: local Postgres + local auth (no accounts needed).
DATABASE_URL=postgresql://padel:padel@localhost:5432/padel
DATABASE_URL_UNPOOLED=postgresql://padel:padel@localhost:5432/padel
LOCAL_AUTH=true
VITE_LOCAL_AUTH=true
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Option B: Neon + Clerk (set LOCAL_AUTH/VITE_LOCAL_AUTH to false or remove them).
# DATABASE_URL=postgresql://...-pooler.../database
# DATABASE_URL_UNPOOLED=postgresql://.../database
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
